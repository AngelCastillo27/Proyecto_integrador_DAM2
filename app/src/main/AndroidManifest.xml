<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>



    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Inventario"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="m">

        <activity
            android:name=".activities.inicio.BienvenidaCeroActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.inicio.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.inicio.InicioGenericoActivity"
            android:exported="false" />

        <activity
            android:name=".activities.inicio.RegistroActivity"
            android:exported="false" />

        <activity
            android:name=".activities.departamentos.DepartamentosActivity"
            android:exported="false" />

        <activity
            android:name=".activities.departamentos.ProductosActivity"
            android:exported="false" />

        <activity
            android:name=".activities.inicio.SelectorRolActivity"
            android:exported="false" />

        <activity android:name=".activities.departamentos.ReportesActivity"
            android:exported="false" />


    </application>

</manifest>
